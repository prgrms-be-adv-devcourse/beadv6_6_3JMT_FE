NEXT_PUBLIC_KAKAO_CLIENT_ID=<카카오-REST-API-키>
NEXT_PUBLIC_TOSS_CLIENT_KEY=<토스-클라이언트-키>
NEXT_PUBLIC_API_URL=http://<AWS-Elastic IP>

# 로컬 직접 라우팅 (기본 꺼짐 — 지금 로컬로 띄워서 테스트할 서비스만 개인적으로 켠다)
# 경로 목록은 본인이 로컬로 띄운 서비스가 실제로 담당하는 경로만 적으면 된다. 이 목록에 없는
# /api/v2/* 요청은 전부 기존처럼 NEXT_PUBLIC_API_URL(AWS-IP)로 간다.
# 예: product-service만 로컬로 테스트하고 싶을 때
NEXT_PUBLIC_LOCAL_PROXY_PATHS=/api/v2/products,/api/v2/sellers/me/products,/api/v2/admin/products
NEXT_PUBLIC_LOCAL_PROXY_TARGET=http://localhost:8082
